APP_ENV=development
APP_NAME=OSSentinel AI
BASE_URL=http://localhost:8000
SESSION_SECRET=change-this-to-a-random-64-char-string
SESSION_HTTPS_ONLY=false
SESSION_SAMESITE=lax
TRUSTED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ORIGINS=http://localhost:8000
GEMINI_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPE=read:user,public_repo
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
DATABASE_URL=sqlite:///./osssentinel.db
FEATURE_TRIAGE=true
FEATURE_PRISM=true
FEATURE_GITPULSE=true
FEATURE_REPORTS=true
FEATURE_SLACK=false
FEATURE_EMAIL=false
ALLOW_DEMO_LOGIN=true
ALLOW_ENV_TOKEN_AUTH=false
TRIAGE_LIMIT_FREE=100
PRISM_LIMIT_FREE=10
GITPULSE_LIMIT_FREE=5
SLACK_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_TO_EMAIL=
